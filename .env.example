# Copy this file to .env and fill in your own key.
# Never commit the real .env file.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional. The app retries the primary model, then falls back automatically.
# Current options include: gemini-3.8-flash, gemini-3.5-flash-lite,
# gemini-3.1-flash-lite, gemini-3.7-flash, gemini-3.6-flash, gemini-3.5-flash
GEMINI_MODEL=gemini-3.8-flash

# Optional: override the comma-separated fallback order.
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
